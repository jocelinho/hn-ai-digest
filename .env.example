# The tool is stateless. State (today's picks + dedup history)
# lives in the Article Reader Cloudflare D1, so nothing local to configure.
# Copy any of these to your shell profile (~/.zshrc) as `export` lines if needed.

# Where the repo lives. Used by the News skill (Claude Code) to locate the script.
# Only needed there, and only if you clone somewhere non-default. Set per machine.
# export HN_AI_DIGEST_DIR="$HOME/Documents/Jocelin/Projects/hn-ai-digest"

# REQUIRED. Your own Article Reader deployment (summarization + digest state).
# There is deliberately no default: don't point this at someone else's service.
# export ARTICLE_READER_API="https://your-article-reader.example.com"

# REQUIRED. Must equal that deployment's WRITE_TOKEN secret
# (`wrangler secret put WRITE_TOKEN` in article-reader). Never commit it.
# export ARTICLE_READER_TOKEN="..."

# How many days back to dedup against previously-picked stories. Default: 14
# export HN_DIGEST_DEDUP_DAYS=14
