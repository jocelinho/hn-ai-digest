# All optional — the skill works with zero config. Copy to your shell profile
# (~/.zshrc) as `export` lines, or source this file before running.

# Where the repo lives. Only needed if you clone somewhere other than the default
# (~/Documents/Jocelin/Projects/hn-ai-digest). Used by the News skill to locate the script.
# export HN_AI_DIGEST_DIR="$HOME/Documents/Jocelin/Projects/hn-ai-digest"

# Cache DB location. Default: processed-articles.db next to the script (local, gitignored).
#   - point at a synced folder (iCloud/Dropbox) to share dedup state across laptops
#   - set to ":memory:" for fully stateless runs (no cache, fresh every time)
# export HN_DIGEST_DB_PATH=":memory:"

# Downstream summarization service. Default: https://article-reader.pages.dev
# export ARTICLE_READER_API="https://article-reader.pages.dev"
